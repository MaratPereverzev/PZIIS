# Пример окружения. Реальный .env создаёт run.sh со случайными значениями.
# В эксплуатации на ВМ этот же набор лежит в /etc/pziis-vault/keys.env
# с правами 0640 root:pziis.

POSTGRES_PASSWORD=<пароль суперпользователя СУБД>
VAULT_DB_PASSWORD=<пароль сервисной роли vault_app>

# Роли из лабораторной работы №1
LAB1_ADMIN_PASSWORD=<пароль admin_sys в СУБД>
LAB1_USER_PASSWORD=<пароль user_sub в СУБД>
LAB1_GUEST_PASSWORD=<пароль guest_read в СУБД>

# 32 байта в base64: openssl rand -base64 32
VAULT_MASTER_KEY=<мастер-ключ>

# Администратор приложения создаётся при первом запуске
VAULT_ADMIN_LOGIN=admin_sys
VAULT_ADMIN_PASSWORD=<пароль администратора приложения>

# Флаг Secure на cookie. Выключать только при запуске без TLS.
VAULT_COOKIE_SECURE=1
